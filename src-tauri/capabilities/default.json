{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bundled pages in every Cortex window. main_window::web_app_capability grants the same permissions to the hosted web app at LUMO_URL's origin.",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-set-webview-zoom",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "dialog:default",
    "log:default",
    "deep-link:default",
    "allow-account",
    "allow-browser-login",
    "allow-downloads",
    "allow-feature-flags",
    "allow-notifications",
    "allow-pdf-export",
    "allow-quick-ask",
    "allow-quick-ask-window",
    "allow-schedules-bridge",
    "allow-settings-commands",
    "allow-settings-window",
    "allow-skills",
    "allow-theme",
    "allow-tools-commands"
  ]
}
