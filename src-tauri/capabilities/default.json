{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bundled pages in every Lumo window. main_window::web_app_capability grants the same permissions to the hosted web app at LUMO_URL's origin.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-set-webview-zoom",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "allow-get-app-settings",
    "allow-save-app-settings",
    "allow-close-settings-window",
    "allow-open-settings-window",
    "allow-take-pending-settings-tab",
    "allow-report-web-theme",
    "allow-get-web-theme",
    "allow-start-browser-login",
    "allow-desktop-feature-flags",
    "allow-is-account-signed-in",
    "allow-set-active-account",
    "allow-clear-active-account",
    "allow-skill-sync-bundle",
    "allow-skill-cache-retain",
    "allow-skill-execute-script",
    "allow-desktop-notification-permission",
    "allow-desktop-notification-show",
    "allow-desktop-notification-open-settings",
    "allow-reveal-download",
    "allow-export-pdf",
    "allow-schedule-connect",
    "allow-schedule-replace",
    "allow-schedule-run-now",
    "allow-schedule-pending",
    "allow-schedule-unsettled",
    "allow-schedule-report-status",
    "allow-inject-search",
    "allow-take-quick-ask",
    "allow-hide-search",
    "allow-get-tool-registry",
    "allow-get-builtin-tools",
    "allow-is-secure-storage-available",
    "allow-set-connector-enabled",
    "allow-set-tool-policy",
    "allow-respond-tool-approval",
    "allow-invoke-tool",
    "allow-register-schedule-execution-context",
    "allow-connect-connector",
    "allow-disconnect-connector",
    "allow-save-mcp-server",
    "allow-list-mcp-servers",
    "allow-remove-mcp-server",
    "allow-pick-directory",
    "dialog:default",
    "log:default",
    "deep-link:default"
  ]
}
