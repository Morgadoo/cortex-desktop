    "allow-chat-delete-project",
    "allow-chat-get-instructions",
    "allow-chat-save-instructions",
    "allow-chat-preview-instructions",
    "allow-chat-export-conversation",
    "allow-chat-get-memories",
    "allow-chat-add-memory",
    "allow-chat-update-memory",
