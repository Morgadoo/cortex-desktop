{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat",
  "description": "The native chat page in the main window: providers, conversations and streaming replies.",
  "local": true,
  "windows": [
    "cortex-window",
    "cortex-chat-*"
  ],
  "permissions": [
    "allow-chat-commands",
    "allow-chat-commands-agents-commands",
    "allow-chat-commands-canvases-commands",
    "allow-chat-commands-code-commands",
    "allow-chat-commands-conversations-commands",
    "allow-chat-commands-knowledge-commands",
    "allow-chat-commands-libraries-commands",
    "allow-chat-commands-misc-commands",
    "allow-chat-commands-providers-commands",
    "allow-chat-commands-settings-commands",
    "allow-chat-commands-tasks-commands",
    "allow-chat-commands-tools-commands",
    "allow-chat-commands-voice-commands",
    "allow-dictation",
    "allow-inapp-browser",
    "allow-tray"
  ]
}
