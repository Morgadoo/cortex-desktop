{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["webview/**/*.ts", "scripts/**/*.mjs", "scripts/**/*.js", "extension/**/*.js", "!webview/pages/settings/index.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 240,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "preserve",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "overrides": [
    {
      "includes": ["scripts/build-desktop-icons.mjs", "scripts/build-webview.mjs", "scripts/check-i18n.mjs", "scripts/generate-luminance-operations.mjs", "scripts/test-webview.mjs", "scripts/ui-strings.mjs"],
      "javascript": { "formatter": { "semicolons": "asNeeded" } }
    }
  ],
  "assist": { "enabled": false },
  "linter": { "enabled": false }
}
