#!/usr/bin/env bash
#
# Type-check and run the interface's unit tests before pushing. CI runs the same check; this only shortens the feedback loop.
#
# Not installed by cloning. Enable with:
#   git config core.hooksPath .githooks

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

# Nothing to check before the first npm install.
[ -x "$repo_root/node_modules/.bin/tsc" ] || exit 0

npm --prefix "$repo_root" run --silent typecheck
npm --prefix "$repo_root" run --silent test
